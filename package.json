{
  "name": "my-beads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "tsx apps/cli/src/generate-chart.ts",
    "generate:pixel": "tsx apps/cli/src/generate-pixel-art.ts",
    "match:color": "tsx apps/cli/src/find-closest-color.ts",
    "dev": "pnpm --filter @my-beads/web dev",
    "lint": "eslint . && pnpm --filter @my-beads/web lint:i18n",
    "typecheck": "tsc --noEmit && pnpm --filter @my-beads/core typecheck && pnpm --filter @my-beads/web typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @my-beads/web test:e2e",
    "test:production": "pnpm --filter @my-beads/web build && pnpm --filter @my-beads/web test:production",
    "build": "pnpm --filter @my-beads/core build && pnpm --filter @my-beads/web build"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-lit": "2.3.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
