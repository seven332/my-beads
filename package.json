{
  "name": "my-beads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "tsx apps/cli/src/generate-chart.ts",
    "generate:pixel": "tsx apps/cli/src/generate-pixel-art.ts",
    "match:color": "tsx apps/cli/src/find-closest-color.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @my-beads/core typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @my-beads/core build"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
